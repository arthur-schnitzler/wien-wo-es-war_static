<?xml version="1.0" encoding="UTF-8"?>
<!--
    Build der statischen Seiten. Vorher:
      ./shellscripts/fetch_data.sh
      uv run pyscripts/prepare_data.py

    ant              alles
    ant seiten       Startseite, 404, Suche, Projektseiten, Impressum, BEACON
    ant tage         Jahres- und Tagesseiten, Weiterleitungen (Phase 1)
    ant register     Register und (vorläufige) Entitätsseiten
    ant entitaeten   Entitätsseiten mit entities.xsl (Phase 3)

    Die Stylesheets erzeugen keine Namensraum-Deklarationen (exclude-result-prefixes="#all",
    kein XHTML-Default-Namensraum); ein nachträgliches <replace> über alle Dateien entfällt.
-->
<project basedir="." name="wohin-in-wien-damals" default="all">
    <loadfile property="DATAHASH" srcFile="./datahash.txt" failonerror="false"/>
    <property name="DATAHASH" value=""/>
    <property name="target" value="./html"/>
    <property name="indices" value="./data/indices"/>
    <!-- generische Eingabe für Seiten, die keine eigene Quelldatei haben -->
    <property name="tage" value="${indices}/tage.xml"/>

    <presetdef name="saxon">
        <xslt force="true">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
            <param name="DATAHASH" expression="${DATAHASH}"/>
            <classpath location="${basedir}/saxon/saxon9he.jar"/>
        </xslt>
    </presetdef>

    <target name="pruefen">
        <available file="${tage}" property="daten.vorbereitet"/>
        <fail unless="daten.vorbereitet"
            message="${tage} fehlt: zuerst ./shellscripts/fetch_data.sh und uv run pyscripts/prepare_data.py ausführen"/>
    </target>

    <target name="clean" description="erzeugte HTML-Seiten löschen">
        <delete>
            <fileset dir="${target}" includes="*.html"/>
        </delete>
    </target>

    <target name="seiten" depends="pruefen" description="Startseite, 404, Suche, Projektseiten, Impressum, BEACON">
        <saxon in="./xslt/list-of-relevant-uris.xml" out="${target}/css/farben.css" style="./xslt/farben.xsl"/>
        <saxon in="${tage}" out="${target}/index.html" style="./xslt/index.xsl"/>
        <saxon in="${tage}" out="${target}/404.html" style="./xslt/404.xsl"/>
        <saxon in="${tage}" out="${target}/search.html" style="./xslt/search.xsl"/>
        <saxon basedir="./data/meta" destdir="${target}" includes="*.xml" style="./xslt/meta.xsl">
            <mapper type="glob" from="*.xml" to="*.html"/>
        </saxon>
        <saxon in="./data/imprint.xml" out="${target}/imprint.html" style="./xslt/imprint.xsl"/>
        <saxon in="${indices}/listperson.xml" out="${target}/beacon.txt" style="./xslt/beacon.xsl"/>
    </target>

    <target name="tage" depends="pruefen" description="Jahres- und Tagesseiten, Weiterleitungen">
        <!-- eine Transformation: jahre.html, JJJJ.html, JJJJ-MM-TT.html, pmbNNNN.html (Ereignisse) -->
        <saxon in="${tage}" out="${target}/jahre.html" style="./xslt/tage.xsl"/>
    </target>

    <target name="register" depends="pruefen" description="Register und vorläufige Entitätsseiten">
        <saxon in="${indices}/listperson.xml" out="${target}/listperson.html" style="./xslt/listperson.xsl"/>
        <saxon in="${indices}/listplace.xml" out="${target}/listplace.html" style="./xslt/listplace.xsl"/>
        <saxon in="${indices}/listorg.xml" out="${target}/listorg.html" style="./xslt/listorg.xsl"/>
        <saxon in="${indices}/listbibl.xml" out="${target}/listbibl.html" style="./xslt/listbibl.xsl"/>
    </target>

    <target name="entitaeten" depends="register" description="Entitätsseiten">
        <!-- Phase 3: Entitätsseiten mit entities.xsl aus schnitzler-chronik-static.
             Bis dahin erzeugen die Register-Stylesheets vorläufige Entitätsseiten. -->
    </target>

    <target name="all" depends="clean, seiten, tage, register, entitaeten"/>
</project>
